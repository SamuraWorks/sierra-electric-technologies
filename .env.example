# ============================================================
# Sierra Electric Technologies HRM — Environment Variables
# Copy to .env.local and fill in your values.
# ============================================================

# Supabase — get these from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only (never expose publicly)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Push notifications — generate with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys(), null, 2))"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@sierraelectric.sl

# Email (Resend) — optional
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=HR <hr@sierraelectric.sl>

# Seeded System Administrator (first-run bootstrap)
ADMIN_EMAIL=admin@sierraelectric.sl
ADMIN_INITIAL_PASSWORD=Super-Admin-2026!

# Demo accounts are seeded with the shared password: Demo@1234